{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "3072175d-c8c2-4861-85b0-20510f3daf38"
  },
  "newProjectRoot": "projects",
  "projects": {
    "E-Learner": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              },
              {
                "glob": "**/*",
                "input": "node_modules/monaco-editor/esm/vs",
                "output": "assets/monaco-editor/vs"
              },
              {
                "glob": "codicon.ttf",
                "input": "node_modules/monaco-editor/esm/vs/base/browser/ui/codicons/codicon",
                "output": "assets/monaco"
              }
            ],
            "loader": {
              ".ttf": "file"
            },
            "styles": [
              "src/styles.css",
              "node_modules/monaco-editor/min/vs/editor/editor.main.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "3MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "E-Learner:build:production"
            },
            "development": {
              "buildTarget": "E-Learner:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
